# Copy to .env and adjust as needed. All vars use the PKA_ prefix.

# Maximum accepted query length in characters (longer -> QUERY_TOO_LONG)
PKA_MAX_QUERY_LENGTH=2000

# Timeout in seconds for calls to Part B
PKA_RETRIEVAL_TIMEOUT_S=10

# Retriever backend: "stub" (in-process fixtures) or "http" (call Part B)
PKA_RETRIEVER_BACKEND=stub

# Base URL of Part B (used when PKA_RETRIEVER_BACKEND=http)
PKA_PART_B_BASE_URL=http://localhost:8001

# LLM backend: only "null" (no-op) is implemented
PKA_LLM_BACKEND=null

# Log level: DEBUG | INFO | WARNING | ERROR
PKA_LOG_LEVEL=INFO

# CORS allowed origins (JSON list). Default: ["*"]
PKA_CORS_ORIGINS=["*"]
